# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False

# Email: leave these blank to keep OTPs in the Django console during the demo.
# To send real email locally, set EMAIL_BACKEND to Django's SMTP backend and
# fill these fields only in backend/.env. Never commit provider app passwords.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15

# AWS
AWS_REGION=ap-south-1
AWS_S3_REGION_NAME=ap-south-1
AWS_STORAGE_BUCKET_NAME=
USE_S3=False

# AI (local development defaults to Ollama; production uses Bedrock + IAM role)
AI_MODEL_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=qwen3:4b
OLLAMA_THINK=False
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# Database (local development remains SQLite unless USE_POSTGRES=True)
USE_POSTGRES=False
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
